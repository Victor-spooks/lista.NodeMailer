<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="./meme.css">
  <title>Atividade Emailer</title>
</head>
<body>
  <%
    var cssErro = { nome: "", email: "", telefone: "", assunto: "", menssagem:""};
    var msgErro = { nome: "", email: "", telefone: "", assunto: "", menssagem:""};

    if (listaErros && listaErros.errors) {
      listaErros.errors.forEach(function(itemErro) {
        if (itemErro.path == "nome") {
          cssErro.nome = "erro";
          msgErro.nome = itemErro.msg;
        }
        if (itemErro.path == "email") {
          cssErro.email = "erro";
          msgErro.email = itemErro.msg;
        }
        if (itemErro.path == "telefone") {
          cssErro.telefone = "erro";
          msgErro.telefone = itemErro.msg;
        }
        if (itemErro.path == "assunto") {
          cssErro.assunto = "erro";
          msgErro.assunto = itemErro.msg;
        }
        if (itemErro.path == "menssagem") {
          cssErro.menssagem = "erro";
          msgErro.menssagem = itemErro.msg;
        }
      });
    }
  %>

  %>

  <form method="post" action="/index">
    <label for="nome">Nome:</label><br>
    <input type="text" name="nome" id="nome" value="<%= campos.nome %>">
    <section><%= msgErro.nome %></section><br>

    <label for="email">E-mail:</label><br>
    <input type="text" name="email" id="email" value="<%= campos.email %>">
    <section><%= msgErro.email %></section><br>

    <label for="telefone">Telefone:</label><br>
    <input type="text" name="telefone" id="telefone" value="<%= campos.telefone %>">
    <section><%= msgErro.telefone %></section><br>

    <label for="assunto">Assunto:</label><br>
    <input type="text" name="assunto" id="assunto" value="<%= campos.assunto %>">
    <section><%= msgErro.assunto %></section><br>

    <label for="menssagem">Menssagem:</label><br>
    <input type="text" name="menssagem" id="menssagem" value="<%= campos.menssagem %>">
    <section><%= msgErro.menssagem %></section><br>

    <button type="submit">Enviar</button>
  </form>

  <% if (resultado) { %>
    <h2>Resultados:</h2>
    <p>Nome: <%= resultado.nome %></p><br>
    <p>E-mail:<%= resultado.email %></p><br>
    <p>Telefone: <%= resultado.telefone %></p><br>
    <p>Assunto: <%= resultado.assunto %></p><br>
    <p>Menssagem: <%= resultado.menssagem %></p>
  <% } else { %>
  <% } %>
</body>
</html>